# ---------------------------------------------------------------------------
# PROG2002 A3 - API environment configuration
# Copy this file to ".env" and fill in your own MySQL credentials.
# The same values are used for local development and for the SCU cPanel setup.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
# NOTE: on SCU cPanel the port is usually assigned by the platform,
# so leave it as 3000 unless your hosting account tells you otherwise.
PORT=3000

# MySQL / MariaDB connection details
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=prog2002_a3
